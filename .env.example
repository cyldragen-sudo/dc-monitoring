# Copy to .env and supply your own password. Never commit the completed .env.
# Docker Compose reads .env; Python scripts use exported libpq variables instead.
POSTGRES_PASSWORD=
DC_POSTGRES_PORT=55432
# The example database is separate from any existing monitoring database.
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=dc_monitoring_demo
PGUSER=postgres
# Set PGPASSFILE or use ~/.pgpass with restrictive permissions. Do not put a
# password on a command line. PSQL may point to a PostgreSQL client executable.
